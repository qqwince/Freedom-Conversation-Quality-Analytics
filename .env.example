# Скопируйте в .env и заполните. Файл .env не коммитится.

# Ссылка GET из задания (с group_id=DEV)
CQA_API_URL=

# Ключи моделей: нужен ключ того провайдера, чья модель выбрана в CQA_LLM_MODEL
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Gemini: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Модель: deepseek-flash, deepseek-v4-pro, gemini-3.5-flash, gemma-4-31b-it …
# Провайдер выбирается по имени модели (deepseek-* → DeepSeek, иначе Gemini)
CQA_LLM_MODEL=deepseek-flash
# Запасные модели при перегрузке (того же провайдера), через запятую
CQA_LLM_FALLBACK_MODELS=deepseek-v4-pro

# Сколько раз оценивать диалог (голосование по большинству) и параллельных запросов
CQA_VOTES=1
CQA_WORKERS=8

# Цена за 1 млн токенов, USD — для расчёта стоимости оценки (пусто — не считать)
CQA_PRICE_INPUT_PER_M=0.30
CQA_PRICE_OUTPUT_PER_M=1.20

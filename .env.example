# Скопируйте в .env и заполните. Файл .env не коммитится.

# Ссылка GET из задания (с group_id=DEV)
CQA_API_URL=

# Ключ Gemini: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Модель и запасные модели при перегрузке (через запятую)
CQA_LLM_MODEL=gemini-3.5-flash
CQA_LLM_FALLBACK_MODELS=gemini-3.6-flash

# Сколько раз оценивать диалог (голосование по большинству) и параллельных запросов
CQA_VOTES=1
CQA_WORKERS=4

# Цена за 1 млн токенов, USD — для расчёта стоимости оценки (пусто — не считать)
CQA_PRICE_INPUT_PER_M=
CQA_PRICE_OUTPUT_PER_M=
